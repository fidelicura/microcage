#!/usr/bin/env python3

"""
Run `microcage --help` for usage information.
"""

import argparse
import datetime
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys

from dataclasses import dataclass
from pathlib import Path
from typing import BinaryIO


COLOR_RED = "\033[31m"
COLOR_RESET = "\033[0m"

SUPPORTED_ARCHITECTURES = {
    "x86_64",
    "amd64",
    "aarch64",
    "arm64",
}

CPU_SYSTEM_PATH = Path("/sys/devices/system/cpu")
CPUFREQ_PATH = CPU_SYSTEM_PATH / "cpufreq"
SMT_CONTROL_PATH = CPU_SYSTEM_PATH / "smt/control"

IRQ_PATH = Path("/proc/irq")
INTERRUPTS_PATH = Path("/proc/interrupts")

THP_ENABLED_PATH = Path(
    "/sys/kernel/mm/transparent_hugepage/enabled"
)

WORKQUEUE_CPUMASK_PATH = Path(
    "/sys/devices/virtual/workqueue/cpumask"
)


@dataclass(frozen=True)
class Operation:
    name: str
    setup: list[str]
    teardown: list[str]
    best_effort: bool = False


@dataclass(frozen=True)
class Capability:
    name: str
    status: str


class Arguments:
    def __init__(self) -> None:
        self.parser = argparse.ArgumentParser(
            usage="microcage [options] -- <BINARY> [ARGS...]",
            description=(
                "Run a command pinned to a Linux logical CPU.\n"
                "System-wide controls are opt-in and restored afterward.\n"
                "OPTIONS MARKED [sudo] REQUIRE ROOT PRIVILEGES."
            ),
            formatter_class=argparse.RawTextHelpFormatter,
        )

        self.parser.add_argument(
            "--cpu-id",
            type=int,
            metavar="<CPU>",
            help="pin the command to this Linux logical CPU ID",
        )

        controls = self.parser.add_argument_group(
            "optional system controls"
        )

        controls.add_argument(
            "--disable-aslr",
            action="store_true",
            help=(
                "[sudo] temporarily disable ASLR\n"
                f"{COLOR_RED}"
                "(requires `sysctl` in $PATH)"
                f"{COLOR_RESET}"
            ),
        )
        controls.add_argument(
            "--disable-nmi",
            action="store_true",
            help=(
                "[sudo] temporarily disable the kernel NMI watchdog\n"
                f"{COLOR_RED}"
                "(requires `sysctl` in $PATH)"
                f"{COLOR_RESET}"
            ),
        )
        controls.add_argument(
            "--disable-smt",
            action="store_true",
            help="[sudo] temporarily disable CPU SMT",
        )
        controls.add_argument(
            "--lock-freq",
            action="store_true",
            help=(
                "[sudo] temporarily select the `performance` "
                "CPU frequency governor"
            ),
        )
        controls.add_argument(
            "--lock-idle-state",
            "--lock-cstate",
            dest="lock_idle_state",
            action="store_true",
            help=(
                "[sudo] keep the shallowest CPU idle state enabled "
                "and disable deeper states"
            ),
        )
        controls.add_argument(
            "--disable-boost",
            action="store_true",
            help=(
                "[sudo] temporarily disable CPU boost or turbo "
                "when a supported runtime control exists"
            ),
        )
        controls.add_argument(
            "--move-irqs",
            action="store_true",
            help=(
                "[sudo] remove the selected CPU from writable IRQ "
                "affinity masks"
            ),
        )
        controls.add_argument(
            "--move-workqueues",
            action="store_true",
            help=(
                "[sudo] remove the selected CPU from the global "
                "unbound-workqueue CPU mask"
            ),
        )
        controls.add_argument(
            "--thp",
            choices=("unchanged", "always", "madvise", "never"),
            default="unchanged",
            help=(
                "[sudo] temporarily set the Transparent Huge Pages "
                "policy (default: unchanged)"
            ),
        )
        controls.add_argument(
            "--require-all-controls",
            action="store_true",
            help=(
                "fail if a requested control is unavailable or rejected"
            ),
        )

        scheduling = self.parser.add_argument_group("scheduling")

        scheduling.add_argument(
            "--scheduler",
            choices=("normal", "fifo"),
            default="normal",
            help=(
                "child scheduling policy (default: normal)\n"
                f"{COLOR_RED}"
                "FIFO requires `sudo` and `chrt` in $PATH"
                f"{COLOR_RESET}"
            ),
        )
        scheduling.add_argument(
            "--scheduler-priority",
            type=self._fifo_priority,
            default=50,
            metavar="<1-99>",
            help=(
                "FIFO real-time priority used with "
                "`--scheduler fifo` (default: 50)"
            ),
        )

        execution = self.parser.add_argument_group("execution")

        execution.add_argument(
            "--iterations-count",
            type=self._positive_integer,
            default=1,
            metavar="<COUNT>",
            help="number of sequential executions (default: 1)",
        )
        execution.add_argument(
            "--redirect-stdout",
            action="store_true",
            help="write each run's stdout to `stdout.log`",
        )
        execution.add_argument(
            "--redirect-stderr",
            action="store_true",
            help="write each run's stderr to `stderr.log`",
        )
        execution.add_argument(
            "--output-path",
            type=Path,
            default=None,
            metavar="<PATH>",
            help=(
                "base directory for timestamped output directories "
                "(default: current directory)"
            ),
        )
        execution.add_argument(
            "--exit-code",
            choices=("worst", "last"),
            default="last",
            help=(
                "aggregate value written to the top-level `exit.code`:\n"
                "  last   last run's exit code\n"
                "  worst  first non-zero exit code, or zero\n"
                "(default: last)"
            ),
        )
        execution.add_argument(
            "--record-flamegraph",
            action="store_true",
            help=(
                "[sudo] record perf samples and create one "
                "`flame.svg` per run\n"
                f"{COLOR_RED}"
                "(requires `perf`, `stackcollapse-perf.pl`, and "
                "`flamegraph.pl` in $PATH)"
                f"{COLOR_RESET}"
            ),
        )

        diagnostics = self.parser.add_argument_group("diagnostics")

        diagnostics.add_argument(
            "--dry-run",
            action="store_true",
            help="print requested changes and commands without applying them",
        )

        self.parser.add_argument(
            "command",
            metavar="<COMMAND>",
            nargs=argparse.REMAINDER,
            help="binary and arguments to execute; place them after `--`",
        )

    def parse(self) -> argparse.Namespace:
        namespace = self.parser.parse_args()

        self._validate_platform()
        self._validate_separator()

        if namespace.cpu_id is None:
            self.parser.error("--cpu-id is required")

        if namespace.cpu_id < 0:
            self.parser.error(
                "--cpu-id must be greater than or equal to 0"
            )

        if namespace.command and namespace.command[0] == "--":
            namespace.command = namespace.command[1:]

        if not namespace.command:
            self.parser.error(
                "missing command; use: microcage [options] -- "
                "<BINARY> [ARGS...]"
            )

        namespace.command[0] = str(
            self._resolve_binary(namespace.command[0])
        )

        binary_name = Path(namespace.command[0]).name

        if namespace.output_path is None:
            namespace.output_path = Path.cwd() / binary_name
        else:
            namespace.output_path = namespace.output_path.expanduser()

        namespace.output_path = namespace.output_path.resolve()

        output_path_was_supplied = any(
            argument == "--output-path"
            or argument.startswith("--output-path=")
            for argument in sys.argv[1:]
        )

        creates_output = (
            namespace.redirect_stdout
            or namespace.redirect_stderr
            or namespace.record_flamegraph
        )

        if output_path_was_supplied and not creates_output:
            print(
                "Warning: --output-path has no effect without "
                "--redirect-stdout, --redirect-stderr, or "
                "--record-flamegraph",
                file=sys.stderr,
            )

        return namespace

    def _validate_platform(self) -> None:
        if sys.platform != "linux":
            self.parser.error("only Linux is supported")

        architecture = platform.machine().lower()

        if architecture not in SUPPORTED_ARCHITECTURES:
            self.parser.error(
                f"unsupported architecture: {architecture}; "
                "supported architectures are x86-64 and AArch64"
            )

    def _validate_separator(self) -> None:
        if "--" not in sys.argv[1:]:
            self.parser.error(
                "the command must follow `--`; use: "
                "microcage [options] -- <BINARY> [ARGS...]"
            )

    @staticmethod
    def _positive_integer(raw: str) -> int:
        try:
            value = int(raw)
        except ValueError as error:
            raise argparse.ArgumentTypeError(
                f"expected an integer, got: {raw}"
            ) from error

        if value < 1:
            raise argparse.ArgumentTypeError(
                "value must be greater than or equal to 1"
            )

        return value

    @staticmethod
    def _fifo_priority(raw: str) -> int:
        try:
            value = int(raw)
        except ValueError as error:
            raise argparse.ArgumentTypeError(
                f"expected an integer, got: {raw}"
            ) from error

        if not 1 <= value <= 99:
            raise argparse.ArgumentTypeError(
                "FIFO priority must be between 1 and 99"
            )

        return value

    @staticmethod
    def _resolve_binary(raw: str) -> Path:
        candidate = Path(raw).expanduser()

        if candidate.exists():
            if candidate.is_dir():
                raise argparse.ArgumentTypeError(
                    f"command is a directory: {raw}"
                )

            if not os.access(candidate, os.X_OK):
                raise argparse.ArgumentTypeError(
                    f"command is not executable: {raw}"
                )

            return candidate.resolve()

        found = shutil.which(raw)

        if found:
            return Path(found).resolve()

        raise argparse.ArgumentTypeError(
            f"binary not found: {raw}"
        )


class Applier:
    def __init__(self, arguments: Arguments) -> None:
        self.arguments = arguments.parse()
        self.capabilities: list[Capability] = []
        self.missing_controls: list[str] = []

    @staticmethod
    def _run_output(command: list[str]) -> str | None:
        completed = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )

        if completed.returncode != 0:
            return None

        return completed.stdout.strip()

    @classmethod
    def _sysctl_read(cls, key: str) -> str | None:
        return cls._run_output(["sysctl", "-n", key])

    @staticmethod
    def _read_optional(path: Path) -> str | None:
        try:
            return path.read_text().strip()
        except (FileNotFoundError, PermissionError, OSError):
            return None

    @staticmethod
    def _sudo_write_command(path: Path, value: str) -> list[str]:
        shell_command = (
            f"printf '%s\\n' {shlex.quote(value)} "
            f"> {shlex.quote(str(path))}"
        )
        return ["sudo", "sh", "-c", shell_command]

    @staticmethod
    def _parse_cpu_list(raw: str) -> set[int]:
        cpus: set[int] = set()
        normalized = raw.replace(" ", ",")

        for part in normalized.split(","):
            part = part.strip()

            if not part:
                continue

            if "-" in part:
                start_raw, end_raw = part.split("-", 1)
                start = int(start_raw)
                end = int(end_raw)

                if end < start:
                    raise ValueError(
                        f"invalid CPU range: {part}"
                    )

                cpus.update(range(start, end + 1))
            else:
                cpus.add(int(part))

        return cpus

    @staticmethod
    def _format_cpu_list(cpus: set[int]) -> str:
        if not cpus:
            return ""

        ordered = sorted(cpus)
        ranges: list[str] = []

        start = ordered[0]
        end = start

        for cpu in ordered[1:]:
            if cpu == end + 1:
                end = cpu
                continue

            ranges.append(
                str(start)
                if start == end
                else f"{start}-{end}"
            )
            start = cpu
            end = cpu

        ranges.append(
            str(start)
            if start == end
            else f"{start}-{end}"
        )

        return ",".join(ranges)

    @staticmethod
    def _parse_cpu_mask(raw: str) -> tuple[set[int], int]:
        groups = [
            group.strip()
            for group in raw.strip().split(",")
            if group.strip()
        ]

        if not groups:
            raise ValueError("empty CPU mask")

        cpus: set[int] = set()

        for group_index, group in enumerate(reversed(groups)):
            value = int(group, 16)
            bit_offset = group_index * 32
            bit = 0

            while value:
                if value & 1:
                    cpus.add(bit_offset + bit)

                value >>= 1
                bit += 1

        return cpus, len(groups)

    @staticmethod
    def _format_cpu_mask(
        cpus: set[int],
        minimum_groups: int = 1,
    ) -> str:
        highest_cpu = max(cpus, default=0)
        group_count = max(
            minimum_groups,
            highest_cpu // 32 + 1,
        )

        groups = [0] * group_count

        for cpu in cpus:
            groups[cpu // 32] |= 1 << (cpu % 32)

        rendered: list[str] = []

        for index, value in enumerate(reversed(groups)):
            if index == 0:
                rendered.append(f"{value:x}")
            else:
                rendered.append(f"{value:08x}")

        return ",".join(rendered)

    @staticmethod
    def _active_bracket_value(raw: str) -> str | None:
        match = re.search(r"\[([^\]]+)]", raw)
        return match.group(1) if match else None

    def _available_cpus(self) -> set[int]:
        try:
            return set(os.sched_getaffinity(0))
        except OSError as error:
            raise RuntimeError(
                "cannot determine the process CPU affinity"
            ) from error

    def _online_cpus(self) -> set[int]:
        raw = self._read_optional(
            CPU_SYSTEM_PATH / "online"
        )

        if raw is None:
            raise RuntimeError(
                "cannot read /sys/devices/system/cpu/online"
            )

        try:
            return self._parse_cpu_list(raw)
        except ValueError as error:
            raise RuntimeError(
                f"cannot parse online CPU list: {raw}"
            ) from error

    def _thread_siblings(self, cpu_id: int) -> set[int]:
        path = (
            CPU_SYSTEM_PATH
            / f"cpu{cpu_id}"
            / "topology"
            / "thread_siblings_list"
        )
        raw = self._read_optional(path)

        if raw is None:
            return {cpu_id}

        try:
            return self._parse_cpu_list(raw)
        except ValueError as error:
            raise RuntimeError(
                f"cannot parse SMT siblings for CPU "
                f"{cpu_id}: {raw}"
            ) from error

    def _active_irq_numbers(self) -> set[str]:
        try:
            lines = INTERRUPTS_PATH.read_text().splitlines()
        except OSError:
            return set()

        active: set[str] = set()

        for line in lines:
            prefix, separator, _ = line.partition(":")
            irq = prefix.strip()

            if separator and irq.isdigit():
                active.add(irq)

        return active

    def _record_available(
        self,
        name: str,
        detail: str,
    ) -> None:
        self.capabilities.append(
            Capability(name, detail)
        )

    def _record_skipped(
        self,
        name: str,
        reason: str,
    ) -> None:
        self.capabilities.append(
            Capability(
                name,
                f"unavailable, skipped: {reason}",
            )
        )
        self.missing_controls.append(
            f"{name}: {reason}"
        )

    def _build_sysctl_operation(
        self,
        *,
        name: str,
        key: str,
        value: str,
    ) -> Operation | None:
        previous = self._sysctl_read(key)

        if previous is None:
            self._record_skipped(
                name,
                f"`{key}` is unavailable",
            )
            return None

        self._record_available(
            name,
            f"supported (`{key}`)",
        )

        return Operation(
            name=name,
            setup=[
                "sudo",
                "sysctl",
                "-w",
                f"{key}={value}",
            ],
            teardown=[
                "sudo",
                "sysctl",
                "-w",
                f"{key}={previous}",
            ],
        )

    def _build_smt_operation(self) -> Operation | None:
        state = self._read_optional(SMT_CONTROL_PATH)

        if state is None:
            self._record_skipped(
                "SMT control",
                f"{SMT_CONTROL_PATH} is unavailable",
            )
            return None

        if state == "notsupported":
            self._record_available(
                "SMT control",
                "not supported by this CPU",
            )
            return None

        if state == "forceoff":
            self._record_available(
                "SMT control",
                "already forced off by the kernel",
            )
            return None

        if state == "off":
            self._record_available(
                "SMT control",
                "already disabled",
            )
            return None

        if state != "on":
            self._record_skipped(
                "SMT control",
                f"unknown control state: {state}",
            )
            return None

        self._record_available(
            "SMT control",
            "supported",
        )

        return Operation(
            name="SMT control",
            setup=self._sudo_write_command(
                SMT_CONTROL_PATH,
                "off",
            ),
            teardown=self._sudo_write_command(
                SMT_CONTROL_PATH,
                "on",
            ),
        )

    def _find_cpufreq_policy(self) -> Path | None:
        cpu_id = self.arguments.cpu_id

        if CPUFREQ_PATH.is_dir():
            for policy in sorted(
                CPUFREQ_PATH.glob("policy*")
            ):
                for filename in (
                    "affected_cpus",
                    "related_cpus",
                ):
                    raw = self._read_optional(
                        policy / filename
                    )

                    if raw is None:
                        continue

                    try:
                        cpus = self._parse_cpu_list(raw)
                    except ValueError:
                        continue

                    if cpu_id in cpus:
                        return policy

        cpu_policy = (
            CPU_SYSTEM_PATH
            / f"cpu{cpu_id}"
            / "cpufreq"
        )

        if cpu_policy.is_dir():
            try:
                return cpu_policy.resolve()
            except OSError:
                return cpu_policy

        return None

    def _build_cpufreq_operation(
        self,
    ) -> Operation | None:
        policy = self._find_cpufreq_policy()

        if policy is None:
            self._record_skipped(
                "CPU frequency",
                f"no CPUFreq policy covers CPU "
                f"{self.arguments.cpu_id}",
            )
            return None

        governor_path = policy / "scaling_governor"
        previous = self._read_optional(governor_path)

        if previous is None:
            self._record_skipped(
                "CPU frequency",
                f"{governor_path} is unavailable",
            )
            return None

        available_raw = self._read_optional(
            policy / "scaling_available_governors"
        )

        if available_raw is not None:
            available = set(available_raw.split())

            if "performance" not in available:
                self._record_skipped(
                    "CPU frequency",
                    "`performance` governor is unavailable; "
                    f"available governors: {available_raw}",
                )
                return None

        if previous == "performance":
            self._record_available(
                "CPU frequency",
                f"{policy.name}, already using "
                "`performance`",
            )
            return None

        self._record_available(
            "CPU frequency",
            f"{policy.name}, previous governor "
            f"`{previous}`",
        )

        return Operation(
            name="CPU frequency",
            setup=self._sudo_write_command(
                governor_path,
                "performance",
            ),
            teardown=self._sudo_write_command(
                governor_path,
                previous,
            ),
        )

    def _build_boost_operation(
        self,
    ) -> Operation | None:
        candidates = [
            (
                CPUFREQ_PATH / "boost",
                "0",
                "CPUFreq global boost",
            ),
            (
                CPU_SYSTEM_PATH
                / "intel_pstate"
                / "no_turbo",
                "1",
                "Intel turbo",
            ),
        ]

        policy = self._find_cpufreq_policy()

        if policy is not None:
            candidates.append(
                (
                    policy / "boost",
                    "0",
                    f"{policy.name} boost",
                )
            )

        for path, disabled_value, label in candidates:
            previous = self._read_optional(path)

            if previous not in {"0", "1"}:
                continue

            if previous == disabled_value:
                self._record_available(
                    "CPU boost",
                    f"{label} already disabled",
                )
                return None

            self._record_available(
                "CPU boost",
                f"{label} controlled through {path}",
            )

            return Operation(
                name="CPU boost",
                setup=self._sudo_write_command(
                    path,
                    disabled_value,
                ),
                teardown=self._sudo_write_command(
                    path,
                    previous,
                ),
            )

        self._record_skipped(
            "CPU boost",
            "no supported runtime boost control "
            "was found",
        )
        return None

    @staticmethod
    def _idle_state_number(path: Path) -> int:
        suffix = path.name.removeprefix("state")

        try:
            return int(suffix)
        except ValueError:
            return sys.maxsize

    def _build_idle_operations(
        self,
    ) -> list[Operation]:
        idle_path = (
            CPU_SYSTEM_PATH
            / f"cpu{self.arguments.cpu_id}"
            / "cpuidle"
        )

        if not idle_path.is_dir():
            self._record_skipped(
                "CPU idle states",
                f"{idle_path} is unavailable",
            )
            return []

        states = sorted(
            idle_path.glob("state*"),
            key=self._idle_state_number,
        )

        snapshots: list[tuple[Path, str, str]] = []

        for state in states:
            disable_path = state / "disable"
            previous = self._read_optional(disable_path)

            if previous not in {"0", "1"}:
                continue

            state_number = self._idle_state_number(
                state
            )

            target = (
                "0"
                if state_number == 0
                else "1"
            )

            snapshots.append(
                (
                    disable_path,
                    previous,
                    target,
                )
            )

        if not snapshots:
            self._record_skipped(
                "CPU idle states",
                "no CPUIdle state controls were found",
            )
            return []

        self._record_available(
            "CPU idle states",
            f"{len(snapshots)} states on CPU "
            f"{self.arguments.cpu_id}",
        )

        return [
            Operation(
                name=(
                    f"CPU idle state "
                    f"{path.parent.name}"
                ),
                setup=self._sudo_write_command(
                    path,
                    target,
                ),
                teardown=self._sudo_write_command(
                    path,
                    previous,
                ),
            )
            for path, previous, target in snapshots
            if previous != target
        ]

    def _build_irq_operations(
        self,
    ) -> list[Operation]:
        target_cpu = self.arguments.cpu_id
        available = self._available_cpus()

        if not (available - {target_cpu}):
            self._record_skipped(
                "IRQ affinity",
                "no other CPU is available for "
                "IRQ handling",
            )
            return []

        if not IRQ_PATH.is_dir():
            self._record_skipped(
                "IRQ affinity",
                f"{IRQ_PATH} is unavailable",
            )
            return []

        active_irqs = self._active_irq_numbers()
        operations: list[Operation] = []

        inactive = 0
        unaffected = 0
        ineffective = 0
        pinned = 0

        for irq_directory in sorted(
            IRQ_PATH.iterdir(),
            key=lambda path: (
                int(path.name)
                if path.name.isdigit()
                else sys.maxsize
            ),
        ):
            irq = irq_directory.name

            if not irq.isdigit():
                continue

            if active_irqs and irq not in active_irqs:
                inactive += 1
                continue

            affinity_path = (
                irq_directory
                / "smp_affinity_list"
            )
            previous = self._read_optional(
                affinity_path
            )

            if previous is None:
                continue

            try:
                current_cpus = self._parse_cpu_list(
                    previous
                )
            except ValueError:
                continue

            if target_cpu not in current_cpus:
                unaffected += 1
                continue

            effective_path = (
                irq_directory
                / "effective_affinity_list"
            )
            effective_raw = self._read_optional(
                effective_path
            )

            if effective_raw is not None:
                try:
                    effective_cpus = (
                        self._parse_cpu_list(
                            effective_raw
                        )
                    )
                except ValueError:
                    effective_cpus = set()

                if (
                    effective_cpus
                    and target_cpu not in effective_cpus
                ):
                    ineffective += 1
                    continue

            replacement = current_cpus - {target_cpu}

            if not replacement:
                pinned += 1
                continue

            operations.append(
                Operation(
                    name=f"IRQ {irq} affinity",
                    setup=self._sudo_write_command(
                        affinity_path,
                        self._format_cpu_list(
                            replacement
                        ),
                    ),
                    teardown=self._sudo_write_command(
                        affinity_path,
                        previous,
                    ),
                    best_effort=True,
                )
            )

        details = (
            f"{len(operations)} candidate IRQs "
            f"will exclude CPU {target_cpu}"
        )

        skipped: list[str] = []

        if unaffected:
            skipped.append(
                f"{unaffected} already excluded it"
            )
        if ineffective:
            skipped.append(
                f"{ineffective} did not effectively "
                "use it"
            )
        if inactive:
            skipped.append(
                f"{inactive} were inactive"
            )
        if pinned:
            skipped.append(
                f"{pinned} had no alternative "
                "allowed CPU"
            )

        if skipped:
            details += "; " + ", ".join(skipped)

        self._record_available(
            "IRQ affinity",
            details,
        )

        return operations

    def _build_thp_operation(
        self,
    ) -> Operation | None:
        requested = self.arguments.thp

        if requested == "unchanged":
            return None

        raw = self._read_optional(THP_ENABLED_PATH)

        if raw is None:
            self._record_skipped(
                "Transparent Huge Pages",
                f"{THP_ENABLED_PATH} is unavailable",
            )
            return None

        previous = self._active_bracket_value(raw)

        if previous is None:
            self._record_skipped(
                "Transparent Huge Pages",
                f"cannot determine active policy "
                f"from: {raw}",
            )
            return None

        available = {
            item.strip("[]")
            for item in raw.split()
        }

        if requested not in available:
            self._record_skipped(
                "Transparent Huge Pages",
                f"`{requested}` is unavailable; "
                "choices: "
                f"{', '.join(sorted(available))}",
            )
            return None

        if requested == previous:
            self._record_available(
                "Transparent Huge Pages",
                f"already using `{requested}`",
            )
            return None

        self._record_available(
            "Transparent Huge Pages",
            f"`{previous}` -> `{requested}`",
        )

        return Operation(
            name="Transparent Huge Pages",
            setup=self._sudo_write_command(
                THP_ENABLED_PATH,
                requested,
            ),
            teardown=self._sudo_write_command(
                THP_ENABLED_PATH,
                previous,
            ),
        )

    def _build_workqueue_operation(
        self,
    ) -> Operation | None:
        previous = self._read_optional(
            WORKQUEUE_CPUMASK_PATH
        )

        if previous is None:
            self._record_skipped(
                "Unbound workqueues",
                f"{WORKQUEUE_CPUMASK_PATH} "
                "is unavailable",
            )
            return None

        try:
            current_cpus, group_count = (
                self._parse_cpu_mask(previous)
            )
        except ValueError as error:
            self._record_skipped(
                "Unbound workqueues",
                f"cannot parse `{previous}`: {error}",
            )
            return None

        target_cpu = self.arguments.cpu_id

        if target_cpu not in current_cpus:
            self._record_available(
                "Unbound workqueues",
                f"CPU {target_cpu} is already excluded",
            )
            return None

        replacement = current_cpus - {target_cpu}

        if not replacement:
            self._record_skipped(
                "Unbound workqueues",
                "cannot remove the only CPU in "
                "the workqueue mask",
            )
            return None

        new_value = self._format_cpu_mask(
            replacement,
            minimum_groups=group_count,
        )

        self._record_available(
            "Unbound workqueues",
            f"CPU {target_cpu} will be removed "
            "from the global mask",
        )

        return Operation(
            name="Unbound workqueues",
            setup=self._sudo_write_command(
                WORKQUEUE_CPUMASK_PATH,
                new_value,
            ),
            teardown=self._sudo_write_command(
                WORKQUEUE_CPUMASK_PATH,
                previous,
            ),
        )

    def _build_operations(
        self,
    ) -> list[Operation]:
        operations: list[Operation] = []

        if self.arguments.disable_aslr:
            operation = self._build_sysctl_operation(
                name="ASLR control",
                key="kernel.randomize_va_space",
                value="0",
            )

            if operation is not None:
                operations.append(operation)

        if self.arguments.disable_nmi:
            operation = self._build_sysctl_operation(
                name="NMI watchdog",
                key="kernel.nmi_watchdog",
                value="0",
            )

            if operation is not None:
                operations.append(operation)

        if self.arguments.disable_smt:
            operation = self._build_smt_operation()

            if operation is not None:
                operations.append(operation)

        if self.arguments.lock_freq:
            operation = (
                self._build_cpufreq_operation()
            )

            if operation is not None:
                operations.append(operation)

        if self.arguments.disable_boost:
            operation = self._build_boost_operation()

            if operation is not None:
                operations.append(operation)

        if self.arguments.lock_idle_state:
            operations.extend(
                self._build_idle_operations()
            )

        if self.arguments.move_irqs:
            operations.extend(
                self._build_irq_operations()
            )

        thp_operation = self._build_thp_operation()

        if thp_operation is not None:
            operations.append(thp_operation)

        if self.arguments.move_workqueues:
            operation = (
                self._build_workqueue_operation()
            )

            if operation is not None:
                operations.append(operation)

        if self.arguments.record_flamegraph:
            operation = self._build_sysctl_operation(
                name="perf event access",
                key="kernel.perf_event_paranoid",
                value="-1",
            )

            if operation is not None:
                operations.append(operation)

        return operations

    def _validate_required_commands(self) -> None:
        required = {"taskset"}

        uses_sudo = any(
            (
                self.arguments.disable_aslr,
                self.arguments.disable_nmi,
                self.arguments.disable_smt,
                self.arguments.lock_freq,
                self.arguments.lock_idle_state,
                self.arguments.disable_boost,
                self.arguments.move_irqs,
                self.arguments.move_workqueues,
                self.arguments.thp != "unchanged",
                self.arguments.record_flamegraph,
                self.arguments.scheduler == "fifo",
            )
        )

        uses_sysctl = any(
            (
                self.arguments.disable_aslr,
                self.arguments.disable_nmi,
                self.arguments.record_flamegraph,
            )
        )

        if uses_sudo:
            required.add("sudo")

        if uses_sysctl:
            required.add("sysctl")

        if self.arguments.scheduler == "fifo":
            required.add("chrt")

        if self.arguments.record_flamegraph:
            required.update(
                {
                    "perf",
                    "stackcollapse-perf.pl",
                    "flamegraph.pl",
                }
            )

        missing = sorted(
            command
            for command in required
            if shutil.which(command) is None
        )

        if missing:
            raise RuntimeError(
                "required commands not found in $PATH: "
                + ", ".join(missing)
            )

    def _validate_cpu(self) -> None:
        cpu_id = self.arguments.cpu_id
        online = self._online_cpus()
        available = self._available_cpus()

        if cpu_id not in online:
            raise RuntimeError(
                f"CPU {cpu_id} is not online; "
                "online CPUs: "
                f"{self._format_cpu_list(online)}"
            )

        if cpu_id not in available:
            raise RuntimeError(
                f"CPU {cpu_id} is unavailable to "
                "this process; available CPUs: "
                f"{self._format_cpu_list(available)}"
            )

        if (
            self.arguments.move_irqs
            or self.arguments.move_workqueues
        ) and len(available) < 2:
            raise RuntimeError(
                "IRQ or workqueue movement requires "
                "at least two available CPUs"
            )

    def _validate_smt_cpu_selection(self) -> None:
        if not self.arguments.disable_smt:
            return

        state = self._read_optional(SMT_CONTROL_PATH)

        if state != "on":
            return

        cpu_id = self.arguments.cpu_id
        siblings = self._thread_siblings(cpu_id)

        if len(siblings) < 2:
            return

        primary_cpu = min(siblings)

        if cpu_id != primary_cpu:
            raise RuntimeError(
                f"CPU {cpu_id} is an SMT sibling and "
                "may be offlined when SMT is disabled; "
                f"select CPU {primary_cpu} from sibling "
                f"group "
                f"{self._format_cpu_list(siblings)}, "
                "or omit --disable-smt"
            )

    def _validate_selected_cpu_still_online(
        self,
    ) -> None:
        if (
            self.arguments.cpu_id
            not in self._online_cpus()
        ):
            raise RuntimeError(
                f"CPU {self.arguments.cpu_id} "
                "became offline during setup"
            )

    def _print_capabilities(self) -> None:
        print(
            f"Platform: "
            f"{platform.machine().lower()} Linux",
            file=sys.stderr,
        )
        print(
            f"Logical CPU: {self.arguments.cpu_id}",
            file=sys.stderr,
        )

        if not self.capabilities:
            print(
                "System controls: none requested",
                file=sys.stderr,
            )
            return

        for capability in self.capabilities:
            print(
                f"{capability.name}: "
                f"{capability.status}",
                file=sys.stderr,
            )

    def _enforce_required_controls(self) -> None:
        if (
            self.arguments.require_all_controls
            and self.missing_controls
        ):
            details = "\n  ".join(
                self.missing_controls
            )

            raise RuntimeError(
                "requested controls are unavailable:\n"
                f"  {details}"
            )

    def _creates_output(self) -> bool:
        return (
            self.arguments.redirect_stdout
            or self.arguments.redirect_stderr
            or self.arguments.record_flamegraph
        )

    def _create_output_directory(self) -> Path:
        timestamp = (
            datetime.datetime.now()
            .astimezone()
            .strftime("%Y-%m-%d_%H-%M-%S")
        )
        output_directory = (
            self.arguments.output_path
            / timestamp
        )

        suffix = 1

        while output_directory.exists():
            output_directory = (
                self.arguments.output_path
                / f"{timestamp}_{suffix}"
            )
            suffix += 1

        output_directory.mkdir(parents=True)
        return output_directory

    def _build_run_command(
        self,
        run_directory: Path | None,
    ) -> list[str]:
        command: list[str] = []

        if self.arguments.scheduler == "fifo":
            command += [
                "sudo",
                "chrt",
                "-f",
                str(
                    self.arguments.scheduler_priority
                ),
            ]

        command += [
            "taskset",
            "-c",
            str(self.arguments.cpu_id),
        ]

        if self.arguments.record_flamegraph:
            if run_directory is None:
                raise RuntimeError(
                    "flamegraph recording requires "
                    "a run directory"
                )

            command += [
                "perf",
                "record",
                "-F",
                "999",
                "-g",
                "--call-graph",
                "dwarf",
                "-o",
                str(run_directory / "perf.data"),
                "--",
            ]

        command += self.arguments.command
        return command

    def _build_flamegraph(
        self,
        run_directory: Path,
    ) -> None:
        data = run_directory / "perf.data"

        if not data.exists():
            print(
                f"Flamegraph skipped: "
                f"{data} is missing",
                file=sys.stderr,
            )
            return

        if data.stat().st_uid != os.getuid():
            subprocess.run(
                [
                    "sudo",
                    "chown",
                    f"{os.getuid()}:{os.getgid()}",
                    str(data),
                ],
                check=True,
                stdout=subprocess.DEVNULL,
            )

        svg = run_directory / "flame.svg"

        with svg.open("wb") as output:
            script = subprocess.Popen(
                [
                    "perf",
                    "script",
                    "-i",
                    str(data),
                ],
                stdout=subprocess.PIPE,
            )

            if script.stdout is None:
                script.kill()
                raise RuntimeError(
                    "failed to open stdout for "
                    "`perf script`"
                )

            collapse = subprocess.Popen(
                ["stackcollapse-perf.pl"],
                stdin=script.stdout,
                stdout=subprocess.PIPE,
            )
            script.stdout.close()

            if collapse.stdout is None:
                script.kill()
                collapse.kill()
                raise RuntimeError(
                    "failed to open stdout for "
                    "`stackcollapse-perf.pl`"
                )

            flamegraph = subprocess.Popen(
                ["flamegraph.pl"],
                stdin=collapse.stdout,
                stdout=output,
            )
            collapse.stdout.close()

            flamegraph_code = flamegraph.wait()
            collapse_code = collapse.wait()
            script_code = script.wait()

        failures = (
            (
                script_code,
                ["perf", "script"],
            ),
            (
                collapse_code,
                ["stackcollapse-perf.pl"],
            ),
            (
                flamegraph_code,
                ["flamegraph.pl"],
            ),
        )

        for return_code, command in failures:
            if return_code != 0:
                raise subprocess.CalledProcessError(
                    return_code,
                    command,
                )

        print(
            f"Flamegraph: {svg.resolve()}",
            file=sys.stderr,
        )

    @staticmethod
    def _aggregate_exit_code(
        exit_codes: list[int],
        mode: str,
    ) -> int:
        if not exit_codes:
            return 0

        if mode == "last":
            return exit_codes[-1]

        return next(
            (
                code
                for code in exit_codes
                if code != 0
            ),
            0,
        )

    def _print_dry_run(
        self,
        operations: list[Operation],
    ) -> None:
        for operation in operations:
            suffix = (
                " [best effort]"
                if operation.best_effort
                else ""
            )
            print(
                f"Setup [{operation.name}]"
                f"{suffix}: "
                f"{shlex.join(operation.setup)}"
            )

        creates_output = self._creates_output()

        for iteration in range(
            1,
            self.arguments.iterations_count + 1,
        ):
            run_directory = None

            if creates_output:
                run_directory = (
                    self.arguments.output_path
                    / "<timestamp>"
                    / f"run-{iteration}"
                )

            command = self._build_run_command(
                run_directory
            )

            print(
                f"Run {iteration}: "
                f"{shlex.join(command)}"
            )

            if (
                self.arguments.redirect_stdout
                and run_directory is not None
            ):
                print(
                    f"  stdout -> "
                    f"{run_directory / 'stdout.log'}"
                )

            if (
                self.arguments.redirect_stderr
                and run_directory is not None
            ):
                print(
                    f"  stderr -> "
                    f"{run_directory / 'stderr.log'}"
                )

        for operation in reversed(operations):
            print(
                f"Teardown [{operation.name}]: "
                f"{shlex.join(operation.teardown)}"
            )

    def _apply_operation(
        self,
        operation: Operation,
    ) -> bool:
        completed = subprocess.run(
            operation.setup,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )

        if completed.returncode == 0:
            return True

        detail = completed.stderr.strip()

        if (
            not operation.best_effort
            or self.arguments.require_all_controls
        ):
            suffix = (
                f": {detail}"
                if detail
                else ""
            )

            raise RuntimeError(
                f"setup failed "
                f"[{operation.name}]: "
                f"{shlex.join(operation.setup)}"
                f"{suffix}"
            )

        return False

    @staticmethod
    def _restore_operation(
        operation: Operation,
    ) -> None:
        completed = subprocess.run(
            operation.teardown,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )

        if completed.returncode == 0:
            return

        detail = completed.stderr.strip()
        suffix = (
            f": {detail}"
            if detail
            else ""
        )

        print(
            f"Teardown failed "
            f"[{operation.name}]: "
            f"{shlex.join(operation.teardown)}"
            f"{suffix}",
            file=sys.stderr,
        )

    def apply(self) -> None:
        self._validate_required_commands()
        self._validate_cpu()
        self._validate_smt_cpu_selection()

        operations = self._build_operations()

        self._print_capabilities()
        self._enforce_required_controls()

        if self.arguments.dry_run:
            self._print_dry_run(operations)
            return

        output_directory: Path | None = None

        if self._creates_output():
            output_directory = (
                self._create_output_directory()
            )
            print(
                f"Output: {output_directory}",
                file=sys.stderr,
            )

        applied: list[Operation] = []
        exit_codes: list[int] = []

        irq_candidates = sum(
            operation.best_effort
            for operation in operations
        )
        irq_applied = 0

        try:
            for operation in operations:
                if not self._apply_operation(
                    operation
                ):
                    continue

                applied.append(operation)

                if operation.best_effort:
                    irq_applied += 1

            if irq_candidates:
                print(
                    f"IRQ affinity: applied "
                    f"{irq_applied}/"
                    f"{irq_candidates} "
                    "candidate changes",
                    file=sys.stderr,
                )

            self._validate_selected_cpu_still_online()

            for iteration in range(
                1,
                self.arguments.iterations_count + 1,
            ):
                run_directory: Path | None = None

                if output_directory is not None:
                    run_directory = (
                        output_directory
                        / f"run-{iteration}"
                    )
                    run_directory.mkdir()

                command = self._build_run_command(
                    run_directory
                )

                stdout_file: BinaryIO | None = None
                stderr_file: BinaryIO | None = None

                try:
                    if (
                        self.arguments.redirect_stdout
                        and run_directory is not None
                    ):
                        stdout_file = (
                            run_directory
                            / "stdout.log"
                        ).open("wb")

                    if (
                        self.arguments.redirect_stderr
                        and run_directory is not None
                    ):
                        stderr_file = (
                            run_directory
                            / "stderr.log"
                        ).open("wb")

                    completed = subprocess.run(
                        command,
                        check=False,
                        stdout=stdout_file,
                        stderr=stderr_file,
                    )
                finally:
                    if stdout_file is not None:
                        stdout_file.close()

                    if stderr_file is not None:
                        stderr_file.close()

                exit_codes.append(
                    completed.returncode
                )

                if run_directory is not None:
                    (
                        run_directory
                        / "exit.code"
                    ).write_text(
                        f"{completed.returncode}\n"
                    )

                if (
                    self.arguments.record_flamegraph
                    and run_directory is not None
                ):
                    try:
                        self._build_flamegraph(
                            run_directory
                        )
                    except (
                        OSError,
                        subprocess.SubprocessError,
                    ) as error:
                        print(
                            "Flamegraph generation "
                            f"failed for run-"
                            f"{iteration}: {error}",
                            file=sys.stderr,
                        )

        finally:
            for operation in reversed(applied):
                self._restore_operation(operation)

        if output_directory is not None:
            aggregate = (
                self._aggregate_exit_code(
                    exit_codes,
                    self.arguments.exit_code,
                )
            )
            (
                output_directory
                / "exit.code"
            ).write_text(
                f"{aggregate}\n"
            )


def main() -> None:
    try:
        Applier(Arguments()).apply()
    except (
        OSError,
        RuntimeError,
        subprocess.SubprocessError,
    ) as error:
        print(
            f"Error: {error}",
            file=sys.stderr,
        )
        raise SystemExit(1) from error


if __name__ == "__main__":
    main()
